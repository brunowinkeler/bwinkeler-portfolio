---
import type { CollectionEntry } from "astro:content";
import { formatDateRange } from "../lib/content";

interface Props {
  detailed?: boolean;
  entry: CollectionEntry<"work">;
}

const { detailed = false, entry } = Astro.props;
const { data } = entry;
---

<li>
  <div class="rule-row">
    <time class="rule-row__date" datetime={data.dateStart.toISOString()}>
      {formatDateRange(data.dateStart, data.dateEnd)}
    </time>
    <div>
      <h3 class="rule-row__title">{data.role}</h3>
      <span class="rule-row__meta">
        {
          data.companyUrl ? (
            <a href={data.companyUrl} target="_blank" rel="noopener noreferrer">
              {data.company}
            </a>
          ) : (
            data.company
          )
        }
        {data.location && <> &middot; {data.location}</>}
        {data.employmentType && <> &middot; {data.employmentType}</>}
      </span>
      {data.summary && <p class="rule-row__note">{data.summary}</p>}
      {
        detailed && data.highlights.length > 0 && (
          <ul class="rule-row__highlights">
            {data.highlights.map((highlight) => (
              <li>{highlight}</li>
            ))}
          </ul>
        )
      }
      {
        data.technologies.length > 0 && (
          <ul
            class="tag-list"
            aria-label={`Technologies used at ${data.company}`}
          >
            {data.technologies.map((technology) => (
              <li class="tag">{technology}</li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</li>
