---
import type { CollectionEntry } from "astro:content";
import { contentUrl, formatDate } from "../lib/content";

interface Props {
  entry: CollectionEntry<"blog">;
}

const { entry } = Astro.props;
---

<li>
  <a class="rule-row" href={contentUrl("blog", entry.id)}>
    <time class="rule-row__date" datetime={entry.data.date.toISOString()}>
      {formatDate(entry.data.date)}
    </time>
    <span>
      <span class="rule-row__title">{entry.data.title}</span>
      <span class="rule-row__note">{entry.data.description}</span>
      {
        entry.data.tags.length > 0 && (
          <span class="tag-list">
            {entry.data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </span>
        )
      }
    </span>
  </a>
</li>
