---
import { Image } from "astro:assets";
import profilePhoto from "../../img/profile.png";
import { site } from "../config/site";
import SocialLinks from "./SocialLinks.astro";
---

<section class="masthead" aria-labelledby="hero-title">
  <div class="masthead__aside">
    <figure class="masthead__portrait">
      <Image
        src={profilePhoto}
        alt={site.profileImageAlt}
        width={288}
        height={274}
        format="webp"
        quality={82}
        loading="eager"
        fetchpriority="high"
      />
    </figure>
    <p class="masthead__meta label">
      <span>{site.title}</span>
      <span>{site.location}</span>
    </p>
  </div>

  <div>
    <h1 id="hero-title">{site.name}</h1>
    <p class="masthead__lead">{site.introduction}</p>
    {site.about.map((paragraph) => <p class="masthead__about">{paragraph}</p>)}
    <SocialLinks />
  </div>
</section>
