<button
  class="theme-toggle"
  type="button"
  aria-label="Switch to light theme"
  aria-pressed="true"
  data-theme-toggle
>
  <svg
    class="theme-toggle__sun"
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"
    ></path>
  </svg>
  <svg
    class="theme-toggle__moon"
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5 8.5 8.5 0 1 0 20.5 14.6Z"></path>
  </svg>
</button>

<script>
  const themeToggle = document.querySelector<HTMLButtonElement>(
    "[data-theme-toggle]",
  );
  const themeColor = document.querySelector<HTMLMetaElement>(
    'meta[name="theme-color"]',
  );

  function updateThemeControl(theme: "light" | "dark") {
    const isDark = theme === "dark";
    document.documentElement.dataset.theme = theme;
    themeToggle?.setAttribute("aria-pressed", String(isDark));
    themeToggle?.setAttribute(
      "aria-label",
      isDark ? "Switch to light theme" : "Switch to dark theme",
    );
    themeColor?.setAttribute("content", isDark ? "#111718" : "#f5f7f4");
  }

  if (themeToggle) {
    const initialTheme =
      document.documentElement.dataset.theme === "dark" ? "dark" : "light";
    updateThemeControl(initialTheme);

    themeToggle.addEventListener("click", () => {
      const nextTheme =
        document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      updateThemeControl(nextTheme);
      try {
        localStorage.setItem("theme", nextTheme);
      } catch {
        // The selected theme still applies for this page view.
      }
    });
  }
</script>
