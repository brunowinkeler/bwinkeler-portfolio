---
import { getCollection } from "astro:content";
import BlogCard from "../components/BlogCard.astro";
import ProfileHero from "../components/ProfileHero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import WorkEntry from "../components/WorkEntry.astro";
import { site } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sortNewest, sortWorkNewest } from "../lib/content";

const projects = sortNewest(
  (await getCollection("projects")).filter((entry) => !entry.data.draft),
);
const featuredProjects = projects.filter((entry) => entry.data.featured);
const selectedProjects = (
  featuredProjects.length > 0 ? featuredProjects : projects
).slice(0, 4);
const posts = sortNewest(
  (await getCollection("blog")).filter((entry) => !entry.data.draft),
).slice(0, 4);
const recentWork = sortWorkNewest(
  (await getCollection("work")).filter((entry) => !entry.data.draft),
).slice(0, 4);
---

<BaseLayout title={site.name} description={site.description} type="profile">
  <div class="page-shell">
    <ProfileHero />

    {
      posts.length > 0 && (
        <section class="grid-section" aria-labelledby="writing-title">
          <h2 class="grid-section__label" id="writing-title">
            Writing
          </h2>
          <ul class="rule-list">
            {posts.map((post) => (
              <BlogCard entry={post} />
            ))}
          </ul>
          <a class="grid-section__more" href="/blog/">
            All posts
          </a>
        </section>
      )
    }

    <section class="grid-section" aria-labelledby="projects-title">
      <h2 class="grid-section__label" id="projects-title">Projects</h2>
      {
        selectedProjects.length > 0 ? (
          <ul class="rule-list">
            {selectedProjects.map((project) => (
              <ProjectCard entry={project} />
            ))}
          </ul>
        ) : (
          <div class="empty-state">
            <h3>Project studies are being prepared.</h3>
            <p>
              Each entry will document the problem, technical constraints,
              implementation, validation, and outcome.
            </p>
          </div>
        )
      }
      <a class="grid-section__more" href="/projects/">All projects</a>
    </section>

    <section class="grid-section" aria-labelledby="experience-title">
      <h2 class="grid-section__label" id="experience-title">Experience</h2>
      <ul class="rule-list">
        {recentWork.map((entry) => <WorkEntry entry={entry} />)}
      </ul>
      <a class="grid-section__more" href="/experience/">Full history</a>
    </section>
  </div>
</BaseLayout>
