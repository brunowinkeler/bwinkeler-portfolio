---
import { Image } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { contentSlug, formatDate, sortNewest } from "../../lib/content";

export async function getStaticPaths() {
  const posts = sortNewest(
    (await getCollection("blog")).filter((entry) => !entry.data.draft),
  );

  return posts.map((post) => ({
    params: { slug: contentSlug(post.id) },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover?.src}
  type="article"
>
  <article class="article-shell">
    <a class="page-hero__back" href="/blog/">← Back to blog</a>
    <header class="article-header">
      <div class="article-header__meta">
        <time datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        {
          post.data.updatedDate && (
            <span>Updated {formatDate(post.data.updatedDate)}</span>
          )
        }
      </div>
      <h1>{post.data.title}</h1>
      <p class="article-header__description">{post.data.description}</p>
      {
        post.data.tags.length > 0 && (
          <ul class="tag-list" aria-label="Article topics">
            {post.data.tags.map((tag) => (
              <li class="tag">{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    {
      post.data.cover && (
        <figure class="article-cover">
          <Image
            src={post.data.cover}
            alt={post.data.coverAlt ?? post.data.title}
            width={960}
            loading="eager"
          />
        </figure>
      )
    }

    <div class="prose">
      <Content />
    </div>

    <nav class="article-actions" aria-label="Article navigation">
      <a class="button button--secondary" href="/blog/">All posts</a>
    </nav>
  </article>
</BaseLayout>
