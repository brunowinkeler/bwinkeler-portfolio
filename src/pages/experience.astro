---
import { getCollection } from "astro:content";
import WorkEntry from "../components/WorkEntry.astro";
import { site } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sortWorkNewest } from "../lib/content";

const work = sortWorkNewest(
  (await getCollection("work")).filter((entry) => !entry.data.draft),
);
---

<BaseLayout
  title="Experience"
  description={`Professional experience, education, and languages for ${site.name}.`}
>
  <div class="page-shell">
    <header class="page-hero">
      <p class="section-kicker">Experience</p>
      <h1>Professional background</h1>
      <p>
        Embedded and software engineering experience across healthcare,
        aviation, payment systems, electronics R&D, computer vision, and
        robotics.
      </p>
    </header>

    <section class="section--compact" aria-labelledby="work-history-title">
      <h2 class="visually-hidden" id="work-history-title">Work history</h2>
      <ul class="rule-list">
        {work.map((entry) => <WorkEntry entry={entry} detailed />)}
      </ul>
    </section>

    <section class="grid-section" aria-labelledby="education-title">
      <h2 class="grid-section__label" id="education-title">Education</h2>
      <ul class="rule-list">
        <li>
          <div class="rule-row">
            <span class="rule-row__date">{site.education.dateRange}</span>
            <div>
              <h3 class="rule-row__title">{site.education.degree}</h3>
              <span class="rule-row__meta">{site.education.institution}</span>
              <p class="rule-row__note">{site.education.focus}</p>
            </div>
          </div>
        </li>
      </ul>
    </section>

    <section class="grid-section" aria-labelledby="languages-title">
      <h2 class="grid-section__label" id="languages-title">Languages</h2>
      <ul class="rule-list">
        {
          site.languages.map((language) => (
            <li>
              <div class="rule-row">
                <span class="rule-row__date">{language.name}</span>
                <span class="rule-row__note">{language.level}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
